/JOB
//NAME GLASS_PICK
//POS
///NPOS 8,0,0,0,0,0
///TOOL 0
///POSTYPE BASE
///RECTAN
///RCONF 0,0,0,0,0,0,0,0
C00000=945.000,0.000,1195.000,180.0000,0.0000,0.0000
C00001=950.000,750.000,605.000,180.0000,0.0000,0.0000
C00002=950.000,750.000,455.000,180.0000,0.0000,0.0000
C00003=950.000,750.000,605.000,180.0000,0.0000,0.0000
C00004=950.000,-750.000,605.000,180.0000,0.0000,0.0000
C00005=950.000,-750.000,455.000,180.0000,0.0000,0.0000
C00006=950.000,-750.000,605.000,180.0000,0.0000,0.0000
C00007=945.000,0.000,1195.000,180.0000,0.0000,0.0000
//INST
///DATE 2026/11/07 11:50
///COMM GLASS PICK AND PLACE
///ATTR SC,RW
///GROUP1 RB1
NOP
'PICK AND PLACE SAMPLE
SET I000 0
MOVJ C00000 VJ=50.00
*LOOP
WAIT IN#(2)=ON
MOVJ C00001 VJ=60.00
MOVL C00002 V=200.0
DOUT OT#(1) ON
WAIT IN#(1)=ON
TIMER T=0.20
MOVL C00003 V=400.0
MOVJ C00004 VJ=60.00
MOVL C00005 V=200.0
DOUT OT#(1) OFF
WAIT IN#(1)=OFF
TIMER T=0.30
MOVL C00006 V=400.0
MOVJ C00007 VJ=60.00
INC I000
JUMP *LOOP IF I000<3
END
